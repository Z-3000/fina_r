# Supabase 설정
# https://supabase.com 에서 프로젝트 생성 후 Settings > API에서 확인

# Project URL (예: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# anon/public key (예: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
VITE_SUPABASE_ANON_KEY=

# 사용 방법:
# 1. 이 파일을 복사하여 .env 파일로 저장
# 2. 위 값들을 실제 Supabase 프로젝트 정보로 채움
# 3. npm install && npm run dev 실행
